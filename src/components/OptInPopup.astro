---
/**
 * The "Free Chapter Opt In" popup every page opens five seconds after load.
 *
 * On the WordPress site this is a LeadConnector ("Trustymail") iframe written into
 * <head>, plus the loader script that turns it into an `.ep-overlay` popup. Two
 * renderings, chosen by src/config.ts:
 *
 *   embed  — the original iframe and loader, byte-identical to production and in
 *            the same place in the DOM (the parser moves both to the top of <body>,
 *            because an <iframe> is not head content). This is what ships until a
 *            Growthmap endpoint is configured, so a deploy before the endpoint
 *            exists never replaces a working form with a dead one.
 *   own    — our static form (playbook §4b) inside a popup shell that reproduces the
 *            widget's behaviour and the look the theme's own CSS gives it: a
 *            full-viewport navy gradient with the form centred in a 600px column,
 *            a round ✕ pinned 2% from the top right, opened after the widget's own
 *            `data-trigger-value` of five seconds, closed by the ✕, the backdrop or
 *            Escape, and shown at most three times per visitor — the widget's
 *            `deactivateAfter: 3`.
 *
 *            The gradient is the one the theme writes for `.ep-iFrameContainer
 *            .ep-popup`. Its second background layer, an image, is dropped: that
 *            URL is pasted over itself in the WordPress custom CSS and 404s there
 *            too, so the gradient is all production has ever shown (see the
 *            README's "Original-site bugs").
 */
import ContactForm from './ContactForm.astro';
import { CONTACT_ENDPOINT, FORM_MODE } from '../config';
import { optInHtml } from '../lib/pages';

const useOwnForm = FORM_MODE === 'growthmap' && CONTACT_ENDPOINT !== '';

/** The widget's own trigger and deactivation values, read off its data-attributes. */
const DELAY_SECONDS = 5;
const MAX_SHOWS = 3;

// The markers extract.mjs wrapped the embed in are only needed to find it; the
// fragment is emitted as authored.
const embed = optInHtml.replace(/<!--gm-form:chapter:(start|end)-->/g, '');
---

{useOwnForm ? (
  <div
    class="gm-optin"
    id="gm-optin"
    hidden
    data-delay={DELAY_SECONDS}
    data-max-shows={MAX_SHOWS}
  >
    <div class="gm-optin__backdrop" data-close></div>
    <button type="button" class="gm-optin__close" data-close aria-label="Close">&times;</button>
    <div class="gm-optin__card" role="dialog" aria-modal="true" aria-labelledby="gm-opt-in-chapter-heading">
      <ContactForm variant="chapter" region="opt-in" />
    </div>
  </div>
) : (
  <Fragment set:html={embed} />
)}

<style>
  .gm-optin {
    position: fixed;
    inset: 0;
    z-index: 100000;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* The theme drops the vertical centring at mobile, where the form is taller than
     the viewport and centring would cut off its head. */
  @media screen and (max-width: 767px) {
    .gm-optin { align-items: flex-start; overflow: auto; }
  }

  .gm-optin[hidden] { display: none; }

  .gm-optin__backdrop {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(7 23 41) 0%, #071729f5 100%);
  }

  /* 600px is the width the widget's own popup column renders at. */
  .gm-optin__card {
    position: relative;
    width: 100%;
    max-width: 600px;
    max-height: 100%;
    overflow: auto;
  }

  /* The theme pins the widget's close control 2% from the top right of the overlay
     and draws it as a 30px circle. */
  .gm-optin__close {
    position: absolute;
    top: 2%;
    inset-inline-end: 2%;
    width: 30px;
    height: 30px;
    padding: 0;
    font-size: 20px;
    line-height: 1;
    color: #4a4a4a;
    background: #e8e8e8;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
  }

  .gm-optin__close:focus-visible { outline: 2px solid #0197ce; outline-offset: 2px; }
</style>

<script>
  const popup = document.getElementById('gm-optin');
  if (popup) {
    const key = 'gm-optin-shows';
    const maxShows = Number(popup.dataset.maxShows) || 3;
    const shown = Number(localStorage.getItem(key) || '0');

    const close = () => {
      popup.hidden = true;
      document.body.style.removeProperty('overflow');
    };

    if (shown < maxShows) {
      setTimeout(() => {
        popup.hidden = false;
        document.body.style.overflow = 'hidden';
        localStorage.setItem(key, String(shown + 1));
        popup.querySelector<HTMLElement>('.gm-optin__close')?.focus();
      }, (Number(popup.dataset.delay) || 5) * 1000);
    }

    for (const el of popup.querySelectorAll('[data-close]')) {
      el.addEventListener('click', close);
    }
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !popup.hidden) close();
    });
  }
</script>
