# Canonical URL. Defaults to the production domain; set it on a preview deployment
# so canonical tags and the sitemap describe that deployment.
PUBLIC_SITE_URL=https://meaningisthemission.com

# Growthmap lead endpoint the two forms POST to (playbook §4b). Public by design —
# it is read in the browser.
#
# While this is empty the pages keep the original LeadConnector ("Trustymail")
# iframes, so a deploy before the endpoint exists never ships a dead form. Set it in
# Vercel and our own static forms take over on the next build.
PUBLIC_CONTACT_ENDPOINT=

# Force the original LeadConnector embeds back even once the endpoint is set.
# `growthmap` (default) or `embed`.
PUBLIC_FORM_MODE=growthmap

# The GoHighLevel chat bubble WordPress loads at the foot of every page.
# `on` (default) or `off`.
PUBLIC_CHAT_WIDGET=on

# The "Free Chapter Opt In" popup every page opens five seconds after load.
# `on` (default, what production does) or `off`.
PUBLIC_OPT_IN_POPUP=on

# Whether the pages keep WordPress's `noindex, nofollow`. `on` (default) reproduces
# production, which de-indexes every URL including the home page — almost certainly
# not intended; see the README's "Original-site bugs". `off` drops the tag.
PUBLIC_NOINDEX=on
